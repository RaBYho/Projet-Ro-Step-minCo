# --- Python (Back-end) ---
# Environnements virtuels
venv/
.venv/
env/
.env/
# Fichiers compilés
__pycache__/
*.py[cod]
# Fichiers de configuration sensibles
.env
*.pem

# --- Node.js & Vite (Front-end) ---
# Dépendances (ne jamais inclure)
node_modules/
