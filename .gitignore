npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- IDE & Système ---
# VS Code
.vscode/
# JetBrains (PyCharm, WebStorm, etc.)
.idea/
# Système macOS
.DS_Store
# Système Windows
Thumbs.db

# --- Logs & Divers ---
*.log
